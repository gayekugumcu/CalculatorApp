<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="CalculatorApp.ScientificPage"
    Title="Bilimsel"
    Shell.NavBarIsVisible="False">

    <Grid Padding="12"
          RowDefinitions="Auto,Auto,*"
          RowSpacing="10">

        <!-- Sayfa başlığı -->
        <Label Grid.Row="0"
               Text="Bilimsel"
               Style="{StaticResource CalculatorTitleStyle}" />

        <!-- İşlem geçmişi ve sonuç ekranı -->
        <VerticalStackLayout Grid.Row="1"
                             Spacing="8"
                             Padding="0,5">

            <Label x:Name="HistoryLabel"
                   Text=""
                   Style="{StaticResource CalculatorHistoryStyle}" />

            <Label x:Name="DisplayLabel"
                   Text="0"
                   Style="{StaticResource CalculatorDisplayStyle}" />

        </VerticalStackLayout>


        <Grid Grid.Row="2"
      ColumnDefinitions="*,*,*,*,*"
      RowDefinitions="*,*,*,*,*,*,*"
      ColumnSpacing="4"
      RowSpacing="4">

            <!-- Bilimsel fonksiyonlar -->
            <Button Grid.Row="0" Grid.Column="0" Text="sin" Style="{StaticResource OperatorButtonStyle}" Clicked="SinButton_Clicked"/>
            <Button Grid.Row="0" Grid.Column="1" Text="cos" Style="{StaticResource OperatorButtonStyle}" Clicked="CosButton_Clicked"/>
            <Button Grid.Row="0" Grid.Column="2" Text="tan" Style="{StaticResource OperatorButtonStyle}" Clicked="TanButton_Clicked"/>
            <Button Grid.Row="0" Grid.Column="3" Text="(" Style="{StaticResource OperatorButtonStyle}" Clicked="OpenParenthesisButton_Clicked"/>
            <Button Grid.Row="0" Grid.Column="4" Text=")" Style="{StaticResource OperatorButtonStyle}" Clicked="CloseParenthesisButton_Clicked"/>

            <Button Grid.Row="1" Grid.Column="0" Text="x²" Style="{StaticResource OperatorButtonStyle}" Clicked="SquareButton_Clicked"/>
            <Button Grid.Row="1" Grid.Column="1" Text="xʸ" Style="{StaticResource OperatorButtonStyle}" Clicked="OperatorButton_Clicked"/>
            <Button Grid.Row="1" Grid.Column="2" Text="√x" Style="{StaticResource OperatorButtonStyle}" Clicked="SqrtButton_Clicked"/>
            <Button Grid.Row="1" Grid.Column="3" Text="log" Style="{StaticResource OperatorButtonStyle}" Clicked="LogButton_Clicked"/>
            <Button Grid.Row="1" Grid.Column="4" Text="ln" Style="{StaticResource OperatorButtonStyle}" Clicked="LnButton_Clicked"/>

            <Button Grid.Row="2" Grid.Column="0" Text="π" Style="{StaticResource OperatorButtonStyle}" Clicked="PiButton_Clicked"/>
            <Button Grid.Row="2" Grid.Column="1" Text="e" Style="{StaticResource OperatorButtonStyle}" Clicked="EButton_Clicked"/>
            <Button Grid.Row="2" Grid.Column="2" Text="n!" Style="{StaticResource OperatorButtonStyle}" Clicked="FactorialButton_Clicked"/>
            <Button Grid.Row="2" Grid.Column="3" Text="1/x" Style="{StaticResource OperatorButtonStyle}" Clicked="ReciprocalButton_Clicked"/>
            <Button Grid.Row="2" Grid.Column="4" Text="%" Style="{StaticResource OperatorButtonStyle}" Clicked="PercentButton_Clicked"/>

            <!-- Sayılar ve temel işlemler -->
            <Button Grid.Row="3" Grid.Column="0" Text="7" Style="{StaticResource NumberButtonStyle}" Clicked="NumberButton_Clicked"/>
            <Button Grid.Row="3" Grid.Column="1" Text="8" Style="{StaticResource NumberButtonStyle}" Clicked="NumberButton_Clicked"/>
            <Button Grid.Row="3" Grid.Column="2" Text="9" Style="{StaticResource NumberButtonStyle}" Clicked="NumberButton_Clicked"/>
            <Button Grid.Row="3" Grid.Column="3" Text="÷" Style="{StaticResource OperatorButtonStyle}" Clicked="OperatorButton_Clicked"/>
            <Button Grid.Row="3" Grid.Column="4" Text="CE" Style="{StaticResource OperatorButtonStyle}" Clicked="ClearEntryButton_Clicked"/>

            <Button Grid.Row="4" Grid.Column="0" Text="4" Style="{StaticResource NumberButtonStyle}" Clicked="NumberButton_Clicked"/>
            <Button Grid.Row="4" Grid.Column="1" Text="5" Style="{StaticResource NumberButtonStyle}" Clicked="NumberButton_Clicked"/>
            <Button Grid.Row="4" Grid.Column="2" Text="6" Style="{StaticResource NumberButtonStyle}" Clicked="NumberButton_Clicked"/>
            <Button Grid.Row="4" Grid.Column="3" Text="×" Style="{StaticResource OperatorButtonStyle}" Clicked="OperatorButton_Clicked"/>
            <Button Grid.Row="4" Grid.Column="4" Text="C" Style="{StaticResource OperatorButtonStyle}" Clicked="ClearButton_Clicked"/>

            <Button Grid.Row="5" Grid.Column="0" Text="1" Style="{StaticResource NumberButtonStyle}" Clicked="NumberButton_Clicked"/>
            <Button Grid.Row="5" Grid.Column="1" Text="2" Style="{StaticResource NumberButtonStyle}" Clicked="NumberButton_Clicked"/>
            <Button Grid.Row="5" Grid.Column="2" Text="3" Style="{StaticResource NumberButtonStyle}" Clicked="NumberButton_Clicked"/>
            <Button Grid.Row="5" Grid.Column="3" Text="−" Style="{StaticResource OperatorButtonStyle}" Clicked="OperatorButton_Clicked"/>
            <Button Grid.Row="5" Grid.Column="4" Text="⌫" Style="{StaticResource OperatorButtonStyle}" Clicked="BackspaceButton_Clicked"/>

            <Button Grid.Row="6" Grid.Column="0" Text="±" Style="{StaticResource OperatorButtonStyle}" Clicked="SignButton_Clicked"/>
            <Button Grid.Row="6" Grid.Column="1" Text="0" Style="{StaticResource NumberButtonStyle}" Clicked="NumberButton_Clicked"/>
            <Button Grid.Row="6" Grid.Column="2" Text="," Style="{StaticResource NumberButtonStyle}" Clicked="DecimalButton_Clicked"/>
            <Button Grid.Row="6" Grid.Column="3" Text="+" Style="{StaticResource OperatorButtonStyle}" Clicked="OperatorButton_Clicked"/>
            <Button Grid.Row="6" Grid.Column="4" Text="=" Style="{StaticResource EqualButtonStyle}" Clicked="EqualButton_Clicked"/>

        </Grid>


    </Grid>

</ContentPage>
