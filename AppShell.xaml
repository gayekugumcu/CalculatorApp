<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="CalculatorApp.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:CalculatorApp"
    Title="CalculatorApp">

    <!-- Menüde gösterilecek sayfalar -->
    <ShellContent
        Title="Standart"
        ContentTemplate="{DataTemplate local:StandardPage}"
        Route="StandardPage" />


    <ShellContent
    Title="Bilimsel"
    ContentTemplate="{DataTemplate local:ScientificPage}"
    Route="ScientificPage" />


    <ShellContent
    Title="Ayarlar"
    ContentTemplate="{DataTemplate local:SettingsPage}"
    Route="SettingsPage" />


</Shell>
