<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="CalculatorApp.StandardPage"
    Title="Standart"
    Shell.NavBarIsVisible="False">

    <Grid Padding="20"
          RowDefinitions="Auto,Auto,*"
          RowSpacing="10">

        <!-- Hesap makinesi başlığı -->
        <Label Grid.Row="0"
               Text="Standart"
               Style="{StaticResource CalculatorTitleStyle}" />

        <!-- İşlem geçmişi ve sonuç ekranı -->
        <VerticalStackLayout Grid.Row="1"
                             Spacing="8"
                             Padding="0,20">

            <!-- Önceki işlemi gösterir -->
            <Label x:Name="HistoryLabel"
                   Text=""
                   Style="{StaticResource CalculatorHistoryStyle}" />

            <!-- Girilen sayı veya sonucu gösterir -->
            <Label x:Name="DisplayLabel"
                   Text="0"
                   Style="{StaticResource CalculatorDisplayStyle}" />

        </VerticalStackLayout>


        <!-- Hesap makinesi butonları -->
        <Grid Grid.Row="2"
              ColumnDefinitions="*,*,*,*"
              RowDefinitions="*,*,*,*,*,*"
              ColumnSpacing="5"
              RowSpacing="5">

            <!-- 1. satır -->
            <Button Grid.Row="0" Grid.Column="0"
                    Text="%"
                    Style="{StaticResource OperatorButtonStyle}"
                    Clicked="PercentButton_Clicked"/>

            <Button Grid.Row="0" Grid.Column="1"
                    Text="CE"
                    Style="{StaticResource OperatorButtonStyle}"
                    Clicked="ClearEntryButton_Clicked"/>

            <Button Grid.Row="0" Grid.Column="2"
                    Text="C"
                    Style="{StaticResource OperatorButtonStyle}"
                    Clicked="ClearButton_Clicked"/>

            <Button Grid.Row="0" Grid.Column="3"
                    Text="⌫"
                    Style="{StaticResource OperatorButtonStyle}"
                    Clicked="BackspaceButton_Clicked"/>

            <!-- 2. satır -->
            <Button Grid.Row="1" Grid.Column="0"
                    Text="1/x"
                    Style="{StaticResource OperatorButtonStyle}" 
                    Clicked="ReciprocalButton_Clicked"/>

            <Button Grid.Row="1" Grid.Column="1"
                    Text="x²"
                    Style="{StaticResource OperatorButtonStyle}"
                    Clicked="SquareButton_Clicked"/>

            <Button Grid.Row="1" Grid.Column="2"
                    Text="√x"
                    Style="{StaticResource OperatorButtonStyle}" 
                    Clicked="SquareRootButton_Clicked"/>

            <Button Grid.Row="1" Grid.Column="3"
                    Text="÷"
                    Style="{StaticResource OperatorButtonStyle}" 
                    Clicked="OperatorButton_Clicked"/>

            <!-- 3. satır -->
            <Button Grid.Row="2" Grid.Column="0"
                    Text="7"
                    Style="{StaticResource NumberButtonStyle}" 
                    Clicked="NumberButton_Clicked"/>

            <Button Grid.Row="2" Grid.Column="1"
                    Text="8"
                    Style="{StaticResource NumberButtonStyle}" 
                    Clicked="NumberButton_Clicked"/>

            <Button Grid.Row="2" Grid.Column="2"
                    Text="9"
                    Style="{StaticResource NumberButtonStyle}" 
                    Clicked="NumberButton_Clicked" />

            <Button Grid.Row="2" Grid.Column="3"
                    Text="×"
                    Style="{StaticResource OperatorButtonStyle}" 
                    Clicked="OperatorButton_Clicked"/>

            <!-- 4. satır -->
            <Button Grid.Row="3" Grid.Column="0"
                    Text="4"
                    Style="{StaticResource NumberButtonStyle}" 
                    Clicked="NumberButton_Clicked"/>

            <Button Grid.Row="3" Grid.Column="1"
                    Text="5"
                    Style="{StaticResource NumberButtonStyle}" 
                    Clicked="NumberButton_Clicked"/>

            <Button Grid.Row="3" Grid.Column="2"
                    Text="6"
                    Style="{StaticResource NumberButtonStyle}" 
                    Clicked="NumberButton_Clicked"/>

            <Button Grid.Row="3" Grid.Column="3"
                    Text="−"
                    Style="{StaticResource OperatorButtonStyle}"
                    Clicked="OperatorButton_Clicked"/>

            <!-- 5. satır -->
            <Button Grid.Row="4" Grid.Column="0"
                    Text="1"
                    Style="{StaticResource NumberButtonStyle}" 
                    Clicked="NumberButton_Clicked"/>

            <Button Grid.Row="4" Grid.Column="1"
                    Text="2"
                    Style="{StaticResource NumberButtonStyle}" 
                    Clicked="NumberButton_Clicked"/>

            <Button Grid.Row="4" Grid.Column="2"
                    Text="3"
                    Style="{StaticResource NumberButtonStyle}"
                    Clicked="NumberButton_Clicked"/>

            <Button Grid.Row="4" Grid.Column="3"
                    Text="+"
                    Style="{StaticResource OperatorButtonStyle}"
                    Clicked="OperatorButton_Clicked"/>

            <!-- 6. satır -->
            <Button Grid.Row="5" Grid.Column="0"
                    Text="±"
                    Style="{StaticResource OperatorButtonStyle}"
                    Clicked="SignButton_Clicked"/>

            <Button Grid.Row="5" Grid.Column="1"
                    Text="0"
                    Style="{StaticResource NumberButtonStyle}" 
                    Clicked="NumberButton_Clicked"/>

            <Button Grid.Row="5" Grid.Column="2"
                    Text=","
                    Style="{StaticResource NumberButtonStyle}"
                    Clicked="DecimalButton_Clicked"/>

            <Button Grid.Row="5" Grid.Column="3"
                    Text="="
                    Style="{StaticResource EqualButtonStyle}"
                    Clicked="EqualButton_Clicked"/>

        </Grid>

    </Grid>

</ContentPage>